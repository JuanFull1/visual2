-- Crear la base de datos
CREATE DATABASE cuarto;
USE cuarto;

-- Crear tabla estudiantes
CREATE TABLE estudiantes (
    estCedula VARCHAR(10) NOT NULL PRIMARY KEY,
    estNombre VARCHAR(50) NOT NULL,
    estApellido VARCHAR(50) NOT NULL,
    estDireccion VARCHAR(100),
    estTelefono VARCHAR(15)
);

-- Crear tabla cursos
CREATE TABLE cursos (
    curId CHAR(5) NOT NULL PRIMARY KEY,
    curNombre VARCHAR(20) NOT NULL,
    estCedula CHAR(10) NOT NULL,
    FOREIGN KEY (estCedula) REFERENCES estudiantes(estCedula)
);

